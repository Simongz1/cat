from pathlib import Path

import matplotlib.pyplot as plt
from matplotlib.animation import FFMpegWriter, FuncAnimation
import numpy as np

# Read the output relative to this script, regardless of the current directory.
csv_path = Path(__file__).with_name("positions.csv")
data = np.genfromtxt(csv_path, delimiter=",", names=True)

# Select the available output time closest to the requested time. Direct
# floating-point equality can fail for values such as 0.1.
plot_time = 0.1
available_times = np.unique(data["time"])
selected_time = available_times[
    np.argmin(np.abs(available_times - plot_time))
]
time_mask = np.isclose(data["time"], selected_time)

# Extract locations and velocity magnitude.
xloc = data["x"][time_mask]
yloc = data["y"][time_mask]
speed = data["vmag"][time_mask]

fig, ax = plt.subplots()

particles = ax.scatter(
    xloc,
    yloc,
    c=speed,
    s=40,
    cmap="viridis",
    edgecolors="none",
)

colorbar = fig.colorbar(particles, ax=ax)
colorbar.set_label("Velocity magnitude")

ax.set_xlabel("x")
ax.set_ylabel("y")
ax.set_title(f"Particle positions at t = {selected_time:g}")
ax.set_aspect("equal", adjustable="box")
fig.tight_layout()

plt.show()