#include <iostream>
//call the particle definition
#include "particle.cpp"
#include <vector>
#include <cmath>
#include <cstdlib>
#include <fstream>
using namespace std;

//define a particle initialization function
//this function takes as input the grid parameters and outputs a container of particles

std::vector<particle> initialize_particles(float xmin, float xmax, int nx, float ymin, float ymax, int ny){
    std::vector<particle> particles;

    for (unsigned int i = 0; i < nx; ++i){
        for (unsigned int j = 0; j < ny; ++j){
            particle p;
            p.x = xmin + (xmax - xmin) * i / nx;
            p.y = ymin + (ymax - ymin) * j / ny;

            particles.push_back(p);
        }
    }

    return particles;
}

//define a simple repulsion function for interparticle forces

std::vector<float> interactions(std::vector<particle> particles){
    for (unsigned int i = 0; i < particles.size(); ++i){
        for (unsigned int j = 0; j < particles.size(); ++j){

            //extract pair of particles
            particle pi = particles[i];
            particle pj = particles[j];

            //compute distance and use it to form interaction forces
            std::vector<std::vector<float>> distances(particles.size(), std::vector<float>(particles.size()));
            distances[i][j] = pi.position - pj.position;

            //normalize distance vector to obtain direction of the interaction force
            std::vector<std::vector<float>> directions(particles.size(), std::vector<float>(particles.size()));
            directions[i][j] = distances[i][j] / std::norm(distances[i][j]);

            //compute force as an exponential function of distance
            std::vector<std::vector<float>> forces(particles.size(), std::vector<float>(particles.size()));

            if (i != j){
                if (std::norm(distances[i][j]) < tol){
                    forces[i][j] = std::exp(- 0.5 * std::norm(distances[i][j])) * directions[i][j];
                }
                else {
                    forces[i][j] = 0.;
                }
            }
        }
    }
    return forces;
}

//define a simple leap frog integration for particle motion

void leapfrog(std::vector<particle> &particles, float dt){
    //evaliate acceleration
    std::vector<std::vector<float>> forces = interactions(particles);

    //compute acceleration as F / m = a
    for (unsigned int i = 0; i < particles.size(); ++i){
        particles[i].ax = forces[i] / particles[i].m;
        particles[i].ay = forces[i] / particles[i].m;

        //update velocity
        particles[i].vx = particles[i].vx_old + 0.5f * dt * (particles[i].ax + particles[i].ax_old);
        particles[i].vy = particles[i].vy_old + 0.5f * dt * (particles[i].ay + particles[i].ay_old);

        //update position
        particles[i].x = particles[i].x_old + dt * particles[i].vx + 0.5f * particles[i].ax * dt * dt;
        particles[i].y = particles[i].y_old + dt * particles[i].vy + 0.5f * particles[i].ay * dt * dt;

        //update old values
        particles[i].x_old = particles[i].x;
        particles[i].y_old = particles[i].y;

        particles[i].vx_old = particles[i].vx;
        particles[i].vy_old = particles[i].vy;

        particles[i].ax_old = particles[i].ax;
        particles[i].ay_old = particles[i].ay;
    }
}

int main(){

    //define domain size
    float xmin = 0.;
    float xmax = 10.;
    int nx = 10;

    float ymin = 0.;
    float ymax = 10.;
    int ny = 10;
    
    std::vector<particle> particles = initialize_particles(xmin, xmax, nx, ymin, ymax, ny);

    //define time step and number of steps
    float dt = 0.01;
    int nsteps = 1000;

    //initialize particles at t=0 with nonzero velocity at the right boundary
    for (unsigned int i = 0; i < particles.size(); ++i){
        if (particles[i].x == xmax){
            particles[i].vx = 1.;
        }
    }

    //generate file container
    std::ofstream positions;
    positions.open("positions.csv");

    //iterate over time steps
    for (unsigned int t = 0; t < nsteps; ++t){
        leapfrog(particles, dt);

        //save locations on file
        for (unsigned int i = 0; i < particles.size(); ++i){
            positions << particles[i].x << "," << particles[i].y << std::endl;
        }
    }
    positions.close();

    return 0;
}