    variable = fraction_csv
    execute_on = 'INITIAL TIMESTEP_END'
    csv_fraction = 'fractions_new.csv'
    density_i = density_i  
    bulk_RDX_fraction = 1.
  []
[]

[UserObjects]
  [voronoi_density]
    type = PolycrystalDensityUO
    num_grains = 800
    target_grains = '1'
    range_in = '1 90'
    range_out = '1 90'
    generate_matrix = true
    max_grain_size = 1000
    execute_on = 'INITIAL TIMESTEP_END'
