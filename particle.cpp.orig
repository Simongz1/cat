// define a particle structure class

#include <vector>
#include <cmath>

struct particle {
    float x, y, x_old, y_old;    
    float vx, vy, vx_old, vy_old;
    float ax, ay, ax_old, ay_old;
    float m;

    std::vector<float> position = {x, y};
    std::vector<float> velocity = {vx, vy};
    std::vector<float> acceleration = {ax, ay};
};